# EcoSync Environment Configuration
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
# Optional. If unset, EcoSync uses a local SQLite database.
# DATABASE_URL=postgresql://user:password@host:5432/ecosync
REQUIRE_DATABASE_URL=false

# Optional private Supabase Storage for uploaded waste photos.
# Create a PRIVATE bucket first; keep the secret key only on the Flask server.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_in_local_env_only
SUPABASE_STORAGE_BUCKET=user-media
REQUIRE_CLOUD_STORAGE=false

# Roboflow Computer Vision API Configuration
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=aaditya-pise
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-7
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_CLASSES=PAPER, PLASTIC, GLASS, METAL, CARDBOARD
AI_DEMO_MODE=false
